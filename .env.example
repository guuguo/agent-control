# Generate with: openssl rand -hex 32
RELAY_KEY=replace-with-a-long-random-secret

# Public HTTPS URL routed to the relay. No trailing slash.
RELAY_PUBLIC_URL=https://relay.example.com

# Optional: token copied from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional Sealos helper settings.
AGENT_CONTROL_NAMESPACE=
KUBECONFIG=

# Optional: disable anonymous startup/daily usage ping (opt-out).
# AGENT_CONTROL_DISABLE_TELEMETRY=1
# DO_NOT_TRACK=1

# Optional provider profile overrides (JSON array or comma-separated paths).
# AGENT_CONTROL_CODEX_HOMES=
# AGENT_CONTROL_CLAUDE_CONFIG_DIRS=
# AGENT_CONTROL_AGY_APP_DATA_DIRS=
